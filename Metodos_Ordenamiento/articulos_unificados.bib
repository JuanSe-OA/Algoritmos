    issn = {},
    keywords = {Parallel processing;Education;Hardware;Computers;Games;Programming profession;computing;parallelism;high performance;challenges;teaching},
    month = {Oct},
    number = {},
    pages = {41-44},
    title = {Parallel Computing: Unplugging to Learn},
    volume = {},
