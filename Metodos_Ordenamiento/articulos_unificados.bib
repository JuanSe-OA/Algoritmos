    keywords = {Bridges;Atmospheric measurements;Affordances;Linear regression;Education;Particle measurements;Encoding;Attitude scale;Coding education;Computational thinking;Elementary school},
    month = {March},
    number = {},
    pages = {87-90},
    title = {Exploring Coding Attitudes of Chinese Elementary Students: A Preliminary Study},
    volume = {},
    year = {2022}
}

